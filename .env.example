# Absolute origin used in share links and agent briefs. Defaults to the request host.
# NEXT_PUBLIC_SITE_URL=https://oauth-guides.example.com

# Research agent. With a key, research runs on Claude through the Claude Agent SDK.
# Without one (or with RESEARCH_AGENT=mock) the mock agent replays scripted runs.
# ANTHROPIC_API_KEY=
# RESEARCH_AGENT=claude
# RESEARCH_MODEL=claude-opus-5-5
# RESEARCH_EFFORT=medium            # low | medium | high | xhigh | max
# RESEARCH_BUDGET_USD=3             # per run; the run stops past this
# RESEARCH_MAX_TURNS=40
# RESEARCH_TIMEOUT_MS=480000
# RESEARCH_CONCURRENCY=2            # runs at once; others queue
# RESEARCH_DAILY_LIMIT=50           # runs per UTC day, a backstop on spend
# MATCH_MODEL=claude-haiku-5-5      # places nicknames like "gcal" when static matching can't

# Docs that only render with JavaScript are read through a hosted browser:
# Firecrawl when this is set (free plan: 1,000 pages a month), otherwise Jina
# Reader, which needs no key (20 requests a minute; a free key raises it).
# FIRECRAWL_API_KEY=
# JINA_API_KEY=

# Mock agent pacing: 1 = realistic (~25 s per run), 4 = four times faster.
# MOCK_AGENT_SPEED=1

# The SQLite database for guides, no-OAuth answers and reports. Real research
# defaults to data/oauth-guide.db, seeded from the committed data/*.json; mock
# runs default to .data/oauth-guide.db, unseeded. Both are git-ignored.
# DATABASE_FILE=/data/oauth-guide.db
# REPORTS_DAILY_LIMIT=300
# One line per research run (cost, time, prompt version). Defaults to evals/runs.jsonl.
# RUNS_FILE=/data/runs.jsonl
